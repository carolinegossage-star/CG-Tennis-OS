# CG Tennis OS — Frontend Environment Configuration
# Copy this file to .env and fill in your values before building for production.

# ─── API ──────────────────────────────────────────────────
# The live URL of your deployed backend (must match FRONTEND_URL logic
# on the backend, and must NOT have a trailing slash).
# Assumed subdomain below — change if your backend lives somewhere else
# (e.g. a different port/path on the same Hostinger VPS).
VITE_API_URL=https://api.cgtennisos.com
