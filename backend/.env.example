# Tennis Coaching OS — Environment Configuration
# Copy this file to .env and fill in your values

# ─── SERVER ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_NAME=Tennis Coaching OS
APP_URL=https://cgtennisos.com

# ─── DATABASE (PostgreSQL on Hostinger) ───────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tennis_coaching_os
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── REDIS (for caching & sessions) ───────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── EMAIL (for notifications & password reset) ───────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@cgtennisos.com
SMTP_PASS=your_email_password
EMAIL_FROM=CG Tennis OS <noreply@cgtennisos.com>

# ─── ANTHROPIC AI ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── WEATHER (WeatherAPI primary, Open-Meteo fallback — no key needed) ────
# Free tier: 1M calls/month. Sign up at https://www.weatherapi.com/signup.aspx
# If unset, every forecast request falls back to Open-Meteo automatically.
WEATHERAPI_KEY=your_weatherapi_key

# ─── FILE UPLOADS ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,audio/webm,audio/mp3,audio/wav

# ─── RATE LIMITING ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── FRONTEND URL (for CORS) ──────────────────────────────
FRONTEND_URL=https://cgtennisos.com

# ─── CLOUDFLARE R2 (for file storage) ─────────────────────
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=tennis-coaching-os

# ─── OPENAI (for voice transcription) ──────────────────────
OPENAI_API_KEY=your_openai_api_key

# ─── STRIPE (self-serve subscriptions) ────────────────────
# Only Starter (£12/mo) and Professional (£29/mo) are self-serve.
# Academy is contact-sales and has no price ID by design.
# Webhook endpoint to register in the Stripe Dashboard:
#   https://api.cgtennisos.com/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STARTER=price_your_starter_monthly_price_id
STRIPE_PRICE_PROFESSIONAL=price_your_professional_monthly_price_id

# ─── LOGGING ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log
